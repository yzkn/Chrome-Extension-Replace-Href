{
  "name": "Momban",
  "version": "1.0.0",
  "manifest_version": 3,
  "description": "ページ内のハイパーリンクを検査してフィッシングを防ぐ",
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://qiita.com/*"
  ],
  "content_scripts": [
    {
      "js": [
        "momban.js"
      ],
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.office.com/*",
        "https://qiita.com/*"
      ],
      "run_at": "document_end",
      "all_frames": true
    }
  ],
  "options_page": "options.html"
}